# Copy to .env (never commit .env). All values are read at start-up and validated.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://milcsoguard:CHANGE_ME@db:5432/milcsoguard
# openssl rand -base64 32   (losing it makes stored TOTP secrets / webhooks unreadable)
APP_ENCRYPTION_KEY=
# Serve the built dashboard from the API (same origin, no CORS needed)
WEB_DIST_DIR=../web/dist
# Only when the dashboard is hosted on a different origin:
CORS_ORIGINS=
# Behind a TLS-terminating reverse proxy (nginx, Caddy, Traefik):
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=72
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
RETENTION_JOB_MINUTES=60
GAME_HEARTBEAT_STALE_SECONDS=120
# Development only (plain http from the game server on localhost):
ALLOW_INSECURE_GAME_HTTP=false
